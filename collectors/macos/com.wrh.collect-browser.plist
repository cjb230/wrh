<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copy to ~/Library/LaunchAgents/ on an everyday Mac, fix the path, then:
     launchctl load ~/Library/LaunchAgents/com.wrh.collect-browser.plist -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.wrh.collect-browser</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/cjb/repos/wrh/collectors/macos/collect-browser.sh</string>
    </array>
    <key>StartInterval</key><integer>3600</integer>
    <key>StandardErrorPath</key><string>/tmp/wrh-collect-browser.log</string>
</dict>
</plist>
